# Prompt Wars Environment Variables
# Copy this file to .env and fill in your values.
#
# Every variable listed here is actually read by code. See supabase/ENV_VARS.md
# for the full reference (defaults, fallback chains, which are optional).

# ============================================================
# MOBILE PUBLIC VARIABLES (safe to bundle in the app)
# Only EXPO_PUBLIC_* reaches the app bundle -- anything else
# in this file is invisible to the client at runtime.
# ============================================================

# Supabase - Public client keys
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# RevenueCat - Public API keys (per platform)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-ios-key-here
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-android-key-here

# EAS project ID (required for push notifications; from `eas project:info`)
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id-here

# ============================================================
# LOCAL SCRIPTS (not needed to run the app or backend)
# ============================================================

# Used by `yarn assets:generate` and scripts/generate-signature-icons.mjs
# GEMINI_API_KEY=AIza...

# ============================================================
# BACKEND/EDGE FUNCTION SECRET VARIABLES
# (DO NOT set these in the mobile .env -- the client cannot read
# them. Configure them with `supabase secrets set KEY=value`.)
# Documented here for reference only.
# ============================================================

# --- Supabase (server-side) ---
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# the Edge Function runtime -- do not set them yourself.
# SUPABASE_PUBLISHABLE_KEYS={"default":"your-publishable-key-here"}
# SUPABASE_SECRET_KEYS={"default":"your-secret-key-here"}

# --- LLM Judge ---
# Implemented: "mock" (default) | "xai". Unset means ranked battles are decided
# by the mock judge (word count + seed), not by a model.
# JUDGE_PROVIDER=xai
# JUDGE_API_KEY=xai-...        # optional, falls back to XAI_API_KEY
# JUDGE_MODEL_ID=grok-4.3      # cheapest Grok 4 with structured outputs; grok-4.6 = best quality
# JUDGE_API_BASE_URL=https://api.x.ai/v1   # optional, falls back to XAI_API_BASE_URL
# (JUDGE_PROMPT_VERSION is frozen in code at _shared/judge.ts, not an env var)

# --- Move prompt suggestions (generate-move-suggestions) ---
# Both optional; fall back to the judge's key and model.
# SUGGESTIONS_API_KEY=xai-...
# SUGGESTIONS_MODEL_ID=grok-4.3

# --- Tier 1 video generation ---
# Implemented: "mock" (default) | "xai".
# VIDEO_PROVIDER=xai
# XAI_API_KEY=xai-...
# XAI_API_BASE_URL=https://api.x.ai/v1
# XAI_VIDEO_MODEL=grok-imagine-video
# XAI_VIDEO_RESOLUTION=720p
# Reference-to-video (fighters' portraits). DEFAULT OFF -- see ENV_VARS.md
# before enabling; it changes the model and therefore unit economics.
# XAI_VIDEO_REFERENCE_ENABLED=false
# XAI_VIDEO_REFERENCE_MODEL=grok-imagine-video-1.5

# --- Character portrait / item image generation ---
# Routes xAI -> OpenAI, both hard-coded; keys only, no provider switch.
# Uses XAI_API_KEY above plus OPENAI_API_KEY below.
# IMAGE_PROVIDER_MODE=fallback   # forces the deterministic 1x1 PNG stub (tests/offline)

# --- Text moderation ---
# No provider switch: the first key present wins (OpenAI preferred).
# Moderation FAILS CLOSED -- with neither key set, Edge Functions throw when
# accepting user-generated prompts unless ENVIRONMENT/DENO_ENV is
# development|test, or DENO_TESTING is set.
# OPENAI_API_KEY=sk-...
# PERSPECTIVE_API_KEY=AIza...

# --- Video moderation ---
# Implemented: "manual" (default, human review queue) | "hive".
# VIDEO_MODERATION_PROVIDER=manual
# HIVE_API_KEY=your-hive-api-key

# --- Account-farm guard (all optional; degrades gracefully) ---
# IP_GEOLOCATION_API_KEY=...
# APPLE_TEAM_ID=...
# APPLE_KEY_ID=...
# APPLE_PRIVATE_KEY=...        # base64-encoded .p8
# GOOGLE_PLAY_INTEGRITY_API_KEY=AIza...

# --- RevenueCat (server-side) ---
# Only the webhook secret is used; there is no server-side RC REST call.
# REVENUECAT_WEBHOOK_SECRET=sk_...

# --- Dev/QA kill switch ---
# Gates dev-only functions (dev-generate-video) that bypass entitlements and
# charge 0 credits. Must be exactly "1" to enable. LEAVE UNSET IN PRODUCTION.
# DEV_FUNCTIONS_ENABLED=1

# --- Remote integration tests ---
# `yarn test:supabase:remote` self-skips unless this is exactly "1".
# PROMPT_WARS_REMOTE_FUNCTION_TESTS=1

# ============================================================
# NOTES
# ============================================================
# - Push notifications need no server credentials: _shared/push.ts posts to
#   Expo's unauthenticated push endpoint.
# - Bundle IDs (gg.promptwars.app) and the deep-link scheme (promptwars) are
#   hard-coded in app.config.js, not env vars.
# - App Store / Play signing credentials live in EAS, never in this repo.
# - See supabase/ENV_VARS.md for the full reference and
#   docs/prompt-wars-implementation-concept.md for architecture.
